#!/usr/bin/env python3
import sys

x = 0
has_input = False

try:
    for line in sys.stdin:
        has_input = True
        # 入力を数値に変換しようとする（int -> floatの順で試行）
        line_str = line.rstrip()
        try:
            x += int(line_str)
        except ValueError:
            x += float(line_str)

    # 入力が空（何も入力されなかった）場合は異常終了
    if not has_input:
        sys.exit(1)

    # 正常に計算できた場合のみ結果を出力して終了ステータス 0
    print(x)
    sys.exit(0)

except ValueError:
    # 数値に変換できない値（「あ」など）が含まれていた場合は標準出力に何も出さず異常終了
    sys.exit(1)
